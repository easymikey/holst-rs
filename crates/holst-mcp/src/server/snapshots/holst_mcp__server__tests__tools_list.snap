---
source: crates/holst-mcp/src/server/tests.rs
expression: "*holst.tools"
---
[
  {
    "name": "auth",
    "description": "The account and its workspaces. Start here.",
    "inputSchema": {
      "properties": {
        "with": {
          "items": {
            "enum": [
              "tokens"
            ],
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "workspace",
    "description": "Workspaces.",
    "inputSchema": {
      "properties": {
        "action": {
          "enum": [
            "ls",
            "show",
            "create",
            "rename",
            "log"
          ],
          "type": "string"
        },
        "confirm": {
          "type": "boolean"
        },
        "dry_run": {
          "type": "boolean"
        },
        "joinable": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "query": {
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          },
          "type": "object"
        },
        "user": {
          "description": "created: whose.",
          "type": "string"
        },
        "with": {
          "items": {
            "enum": [
              "members",
              "activity",
              "plan",
              "plans",
              "sso",
              "domains",
              "created"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "workspace": {
          "description": "Id, @N or part of its name; the only one by default.",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "board",
    "description": "Boards and folders: list, show, picture.",
    "inputSchema": {
      "properties": {
        "action": {
          "enum": [
            "ls",
            "show",
            "snap"
          ],
          "type": "string"
        },
        "board": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ]
        },
        "cursor": {
          "type": "string"
        },
        "embed": {
          "type": "boolean"
        },
        "folder": {
          "type": "string"
        },
        "format": {
          "enum": [
            "png",
            "svg"
          ],
          "type": "string"
        },
        "frame": {
          "type": "string"
        },
        "limit": {
          "type": "integer"
        },
        "max_side": {
          "type": "integer"
        },
        "object": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "offline": {
          "type": "boolean"
        },
        "output": {
          "enum": [
            "text",
            "json"
          ],
          "type": "string"
        },
        "padding": {
          "type": "number"
        },
        "rectangle": {
          "type": "string"
        },
        "refresh": {
          "type": "boolean"
        },
        "scale": {
          "type": "number"
        },
        "view": {
          "enum": [
            "tree",
            "trash",
            "both",
            "favorites",
            "recent",
            "sidebar"
          ],
          "type": "string"
        },
        "with": {
          "items": {
            "enum": [
              "members",
              "rights",
              "sharing"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "workspace": {
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "board_write",
    "description": "Change boards and folders and who may use them; save to files.",
    "inputSchema": {
      "properties": {
        "action": {
