  {
    "name": "object_write",
    "description": "Objects on a board: add or edit many in one call, copy, remove, download.",
    "inputSchema": {
      "properties": {
        "action": {
          "enum": [
            "add",
            "edit",
            "cp",
            "rm",
            "get"
          ],
          "type": "string"
        },
        "at": {
          "description": "x,y; add, cp: a free corner by default; edit: unchanged.",
          "type": "string"
        },
        "board": {
          "type": "string"
        },
        "color": {
          "description": "E.g. yellow4.",
          "type": "string"
        },
        "confirm": {
          "type": "boolean"
        },
        "dir": {
          "type": "string"
        },
        "dry_run": {
          "type": "boolean"
        },
        "file": {
          "description": "Where to save it.",
          "type": "string"
        },
        "frame": {
          "type": "string"
        },
        "from": {
          "description": "Or #N: an earlier item.",
          "type": "string"
        },
        "items": {
          "description": "Many at once, each with the arguments of one; at most 100 per call.",
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "kind": {
          "description": "Sticker by default.",
          "enum": [
            "sticker",
            "text",
            "shape",
            "frame",
            "arrow",
            "link",
            "image",
            "file"
