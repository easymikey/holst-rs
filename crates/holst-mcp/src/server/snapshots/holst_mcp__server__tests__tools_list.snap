  {
    "name": "search",
    "description": "Boards and folders by name, text on boards, or both; best first.",
    "inputSchema": {
      "properties": {
        "board": {
          "type": "string"
        },
        "kind": {
          "description": "names: board, folder or any; board_text: an object kind.",
